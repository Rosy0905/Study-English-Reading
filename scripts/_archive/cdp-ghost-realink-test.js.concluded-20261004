/* cdp-ghost-realink-test.js
 * 上一版 cdp-zoom-ghost-test.js 我读错了日志含义，两处结论作废：
 *   ① 日志里的 y=1220 是 backing store 的**设备像素行号**，不是 CSS 高度。
 *      内部 1454 ÷ DPR 1.874 ≈ 776 = 显示高，这是健康状态，不是拉伸。
 *   ② basisH 不回落本身也不产生错位 —— canvas 样式是 height:100%，
 *      backing store 再高也会被等比压回 host 可见高度，归一化坐标自洽。
 *      上一版那个"错位 26.5%"是 total:0（根本没画上）导致的无效读数。
 *
 * 真正要查的：小0主人 2017-10-04 17:08 说"擦不干净的笔迹，
 * 100% 看不见，放大才看得到"（2017t3，她一直在测这篇）。
 *
 * 关键怀疑：**橡皮(destination-out)只擦到了 cv 层，但笔迹可能画在 lv 层**，
 * 或者 redraw 时 clearRect 用 W/H（CSS 基准）而 backing store 更高，
 * 导致上半部分残留 —— 表现就是"擦不干净的淡影"。
 *
 * 本脚本先造一个**已知**的擦除场景，逐层统计像素，定位残留到底在哪一层。
 */
const { spawn } = require('child_process');
const path = require('path');
const EDGE = 'C:/Program Files (x86)/Microsoft/Edge/Application/154.0.4258.53/msedge.exe';
const BASE = 'http://localhost:8123';
const T3 = BASE + '/library/2017/2017-text3-%E5%81%9A%E9%A2%98.html';

const sleep = ms => new Promise(r => setTimeout(r, ms));
function withTimeout(p, ms, t) { return Promise.race([p, sleep(ms).then(() => { throw new Error('超时 ' + t); })]); }
let pass = 0, fail = 0;
function ok(c, m) { if (c) { pass++; console.log('  OK   ' + m); } else { fail++; console.log('  坏  ' + m); } }

(async () => {
  const port = 9253;
  const proc = spawn(EDGE, ['--headless=new', '--disable-gpu', '--remote-debugging-port=' + port,
    '--user-data-dir=' + path.join(process.env.TEMP, 'cdp-gi-' + Date.now()), 'about:blank'], { stdio: 'ignore' });
  let ws, id = 0; const pend = new Map(); const evts = [];
  for (let i = 0; i < 60; i++) {
    try {
      const j = await (await fetch(`http://127.0.0.1:${port}/json/version`)).json();
      ws = new WebSocket(j.webSocketDebuggerUrl);
      await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; }); break;
    } catch (_) { await sleep(300); }
  }
  if (!ws) { console.log('连不上'); proc.kill(); return; }
  const send = (m, p, s) => new Promise(res => { const mid = ++id; pend.set(mid, res); ws.send(JSON.stringify({ id: mid, method: m, params: p || {}, sessionId: s })); });
  ws.onmessage = e => { const m = JSON.parse(e.data);
    if (m.method === 'Runtime.exceptionThrown') evts.push(JSON.stringify((m.params.exceptionDetails || {}).exception || {}).slice(0, 260));
    if (m.id && pend.has(m.id)) { const r = pend.get(m.id); pend.delete(m.id); r(m.result); } };
  const { targetId } = await send('Target.createTarget', { url: 'about:blank' });
  const { sessionId } = await send('Target.attachToTarget', { targetId, flatten: true });
  const S = (m, p) => send(m, p, sessionId);
  const ev = async expr => {
    const r = await withTimeout(S('Runtime.evaluate', { expression: expr, returnByValue: true, awaitPromise: true }), 25000, 'eval');
    if (r && r.exceptionDetails) throw new Error('JS: ' + JSON.stringify(r.exceptionDetails).slice(0, 300));
    return r.result.value;
  };
  await S('Page.enable'); await S('Runtime.enable');
  await S('Emulation.setDeviceMetricsOverride', { width: 1080, height: 700, deviceScaleFactor: 1.8742763996124268, mobile: true });
  await withTimeout(S('Page.navigate', { url: T3 }), 20000, 'nav');
  await sleep(4000);
  /* 干净起点：清库 + 清同步备份 */
  await ev(`(async function(){ try{ await ekzDB.destroy(); }catch(e){}
    try{ Object.keys(localStorage).forEach(function(k){ if(k.indexOf('ekz-ink-bk-')===0) localStorage.removeItem(k); }); }catch(e){}
    return 1; })()`);
  await withTimeout(S('Page.navigate', { url: T3 }), 20000, 'nav2');
  await sleep(6000);

  const SEL = `'#questionWrap .ekz-ink-cv'`;

  /* 逐层统计：返回每层的不透明像素数 + 墨迹纵向范围（换算成 CSS px） */
  const LAYERS = `(function(){
    function scan(c){
      if(!c) return null;
      var w=c.width,h=c.height; if(!w||!h) return null;
      var d=c.getContext('2d').getImageData(0,0,w,h).data;
      var n=0, top=-1, bot=-1;
      for(var y=0;y<h;y++){
        var has=false;
        for(var x=0;x<w;x+=2){ if(d[(y*w+x)*4+3]>8){ has=true; n++; break; } }
        if(has){ if(top<0) top=y; bot=y; }
      }
      var dpr=Math.min(window.devicePixelRatio||1,3);
      return { n:n, w:w, h:h,
        topDev:top, botDev:bot,
        topCSS: top<0?-1:Math.round(top/dpr), botCSS: bot<0?-1:Math.round(bot/dpr) };
    }
    var cv=document.querySelector(${SEL});
    var lv=document.querySelector('#questionWrap .ekz-ink-lv');
    var r=cv?cv.getBoundingClientRect():null;
    var a=scan(cv), b=scan(lv);
    var id='2017-text3-mark';
    var bk=[]; try{ bk=JSON.parse(localStorage.getItem('ekz-ink-bk-'+id+'-question')||'[]'); }catch(e){}
    var tools={}; bk.forEach(function(s){ tools[s.tool]=(tools[s.tool]||0)+1; });
    return JSON.stringify({
      cssH: r?Math.round(r.height):0, dpr:Math.min(window.devicePixelRatio||1,3),
      cv:a, lv:b, strokes:bk.length, tools:tools
    });
  })()`;

  console.log('=== 0. 确认批注模式已开 ===');
  const st = JSON.parse(await ev(`(function(){
    var bar=document.querySelector('.ekz-inkBar, .inkBar, [class*=inkBar]');
    var cv=document.querySelector(${SEL});
    return JSON.stringify({ hasCv: !!cv, barVisible: bar? getComputedStyle(bar).display : 'no-bar',
      cvPE: cv? getComputedStyle(cv).pointerEvents : '-' });
  })()`));
  console.log('  ' + JSON.stringify(st));
  ok(st.hasCv, '题目页画布已挂载');
  ok(st.cvPE === 'auto', '画布可接收指针事件（pointer-events=' + st.cvPE + '）—— 否则画不上');

  /* 画一整条横线（钢笔），量像素 —— 确认画布真的能画上 */
  const LINE = `(async function(){
    var cv=document.querySelector(${SEL});
    if(!cv) return 'no-cv';
    var host=cv.parentElement; host.scrollIntoView({block:'center'});
    await new Promise(function(r){setTimeout(r,400);});
    var r=cv.getBoundingClientRect();
    var vTop=Math.max(r.top,0), vBot=Math.min(r.top+r.height, innerHeight);
    var span=Math.max(vBot-vTop,1);
    var y=vTop+span*0.4;
    function pe(t,xx,yy){ return new PointerEvent(t,{pointerId:41,pointerType:'pen',isPrimary:true,
      bubbles:true,cancelable:true,clientX:xx,clientY:yy,pressure:0.5,buttons:t==='pointerup'?0:1}); }
    var x0=r.left+r.width*0.15, x1=r.left+r.width*0.85;
    cv.dispatchEvent(pe('pointerdown', x0, y));
    await new Promise(function(res){
      var i=0;
      var step=function(){
        i++;
        if(i>24){ cv.dispatchEvent(pe('pointerup', x1, y)); return setTimeout(res,350); }
        cv.dispatchEvent(pe('pointermove', x0+(x1-x0)*i/24, y));
        setTimeout(function(){step();},12);
      };
      step();
    });
    return 'drew@'+Math.round(y);
  })()`;
  console.log('\n=== 1. 画一条横线，确认画布能落像素 ===');
  console.log('  ' + await ev(LINE));
  await sleep(1200);
  let m = JSON.parse(await ev(LAYERS));
  console.log('  ' + JSON.stringify(m));
  ok(m.cv && m.cv.n > 200, 'cv 层有像素（' + (m.cv && m.cv.n) + '）');
  ok(m.strokes >= 1, '笔迹已入库（strokes=' + m.strokes + ' tools=' + JSON.stringify(m.tools) + '）');
  const fullInk = m.cv ? m.cv.n : 0;

  /* 切到荧光笔画一道，盖在钢笔上 —— 模拟她的"爱心上多画荧光笔" */
  console.log('\n=== 2. 用橡皮横穿擦掉中间 40% ===');
  const ERASE = `(async function(){
    var cv=document.querySelector(${SEL});
    var host=cv.parentElement; host.scrollIntoView({block:'center'});
    await new Promise(function(r){setTimeout(r,400);});
    var r=cv.getBoundingClientRect();
    var vTop=Math.max(r.top,0), vBot=Math.min(r.top+r.height, innerHeight);
    var span=Math.max(vBot-vTop,1);
    var y=vTop+span*0.4;                     /* 与钢笔同一条线 */
    function pe(t,xx,yy){ return new PointerEvent(t,{pointerId:42,pointerType:'pen',isPrimary:true,
      bubbles:true,cancelable:true,clientX:xx,clientY:yy,pressure:0.5,buttons:t==='pointerup'?0:1}); }
    cv.dispatchEvent(pe('pointerdown', r.left+r.width*0.35, y));
    await new Promise(function(res){ setTimeout(res,650); });   /* 长按 650ms → 触发橡皮 */
    await new Promise(function(res){
      var x0=r.left+r.width*0.35, x1=r.left+r.width*0.65, i=0;
      var step=function(){
        i++;
        if(i>16){ cv.dispatchEvent(pe('pointerup',x1,y)); return setTimeout(res,400); }
        cv.dispatchEvent(pe('pointermove', x0+(x1-x0)*i/16, y));
        setTimeout(function(){step();},14);
      };
      step();
    });
    return 'erased';
  })()`;
  console.log('  ' + await ev(ERASE));
  await sleep(1500);
  m = JSON.parse(await ev(LAYERS));
  console.log('  ' + JSON.stringify(m));
  ok(m.tools.er >= 1, '橡皮已入库（tools=' + JSON.stringify(m.tools) + '）');
  const erasedInk = m.cv ? m.cv.n : 0;
  ok(erasedInk < fullInk * 0.85, '擦除当场生效（' + fullInk + ' → ' + erasedInk + '）');

  /* 刷新：看擦除效果能不能保住，以及会不会出现"擦不干净"的残留 */
  console.log('\n=== 3. 刷新后：残留墨迹 ===');
  await withTimeout(S('Page.navigate', { url: T3 }), 20000, 'nav3');
  await sleep(6500);
  m = JSON.parse(await ev(LAYERS));
  console.log('  ' + JSON.stringify(m));
  console.log('  刷新前擦完 = ' + erasedInk + '，刷新后 = ' + (m.cv ? m.cv.n : 0));
  ok(m.cv && m.cv.n <= erasedInk * 1.1,
    '刷新后墨迹不超回擦除前的量（' + (m.cv ? m.cv.n : 0) + ' ≤ ' + erasedInk + '）—— 超了就是"擦不干净"');
  ok(m.lv === null || !m.lv.n || m.lv.n < 50, 'lv（实时层）没有残留像素（' + (m.lv ? m.lv.n : 0) + '）');

  /* 关键：墨迹纵向范围 vs 可见高度 —— 真出现"放大才看到"的话这里会超 */
  console.log('\n=== 4. 墨迹纵向范围 vs 可见高度 ===');
  if (m.cv && m.cv.botCSS >= 0) {
    console.log('  墨迹 CSS 纵向 ' + m.cv.topCSS + ' → ' + m.cv.botCSS + '，可见高 ' + m.cssH);
    ok(m.cv.botCSS <= m.cssH + 6, '墨迹底端在可见高度内（' + m.cv.botCSS + ' ≤ ' + m.cssH + '）');
  } else {
    ok(true, '（无墨迹，跳过范围检查）');
  }

  if (evts.length) { console.log('\n  异常:'); [...new Set(evts)].slice(0, 6).forEach(e => console.log('    ! ' + e)); }
  ok(evts.length === 0, '无未捕获异常');

  console.log('\n通过 ' + pass + ' / 失败 ' + fail);
  proc.kill();
  process.exit(fail ? 1 : 0);
})().catch(e => { console.log('失败: ' + e.message); process.exit(1); });
