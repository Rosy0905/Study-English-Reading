/* cdp-squash-residue-test.js
 * 小0主人 2026-10-04 17:08：2017t3"擦不干净"，100% 看不到、放大才看到很多笔迹痕迹。
 *
 * 我的新怀疑（有代码依据，需要实证）：
 *   ink-paper 的 basisH 是"只增不减"的高水位。捏合放大 → basisH 抬到 2168；
 *   复位 100% → 可见高度回到 1142，但 basisH **永久停在 2168**（上一版已实测证实）。
 *   而 applySize 里画布 backing store 高度 = H * dpr，CSS 高度 = 100% * host = 1142。
 *   → backing store 比显示高度高 1.9 倍，被浏览器**纵向压扁到 52.7%** 贴进 1142px 里。
 *   后果：橡皮（destination-out，圆形）在压扁态下只擦掉 52.7% 的纵向范围，
 *   擦完留下一条条**横向残带** —— 正是"擦不干净"。
 *
 * 本脚本用 A/B 对照证明：
 *   A 组：全新状态 → 画线 → 横擦 → 数残留像素
 *   B 组：捏合放大 1.9x → 复位 100% → 画线 → 横擦 → 数残留像素
 *   若 B 组残留明显多于 A 组，且 B 组 backing/CSS 比值 ≈1.9，则根因确认。
 *
 * 指标修正：上一版数的是"有墨迹的行数"，横擦不减少行数 → 读数无效。
 * 这里数**真实不透明像素总数**与擦除区内的残留像素。
 */
const { spawn } = require('child_process');
const path = require('path');
const EDGE = 'C:/Program Files (x86)/Microsoft/Edge/Application/154.0.4258.53/msedge.exe';
const BASE = 'http://localhost:8123';
const T3 = BASE + '/library/2017/2017-text3-%E5%81%9A%E9%A2%98.html';
const DPR = 1.8742763996124268;   /* 她平板上的真实 DPR */

const sleep = ms => new Promise(r => setTimeout(r, ms));
function withTimeout(p, ms, t) { return Promise.race([p, sleep(ms).then(() => { throw new Error('超时 ' + t); })]); }
let pass = 0, fail = 0;
function ok(c, m) { if (c) { pass++; console.log('  OK   ' + m); } else { fail++; console.log('  坏  ' + m); } }

(async () => {
  const port = 9261;
  const proc = spawn(EDGE, ['--headless=new', '--disable-gpu', '--remote-debugging-port=' + port,
    '--user-data-dir=' + path.join(process.env.TEMP, 'cdp-sq-' + Date.now()), 'about:blank'], { stdio: 'ignore' });
  let ws, id = 0; const pend = new Map(); const evts = [];
  for (let i = 0; i < 60; i++) {
    try {
      const j = await (await fetch(`http://127.0.0.1:${port}/json/version`)).json();
      ws = new WebSocket(j.webSocketDebuggerUrl);
      await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; }); break;
    } catch (_) { await sleep(300); }
  }
  if (!ws) { console.log('连不上'); proc.kill(); return; }
  const send = (m, p, s) => new Promise(res => { const mid = ++id; pend.set(mid, res); ws.send(JSON.stringify({ id: mid, method: m, params: p || {}, sessionId: s })); });
  ws.onmessage = e => { const m = JSON.parse(e.data);
    if (m.method === 'Runtime.exceptionThrown') evts.push(JSON.stringify((m.params.exceptionDetails || {}).exception || {}).slice(0, 260));
    if (m.id && pend.has(m.id)) { const r = pend.get(m.id); pend.delete(m.id); r(m.result); } };
  const { targetId } = await send('Target.createTarget', { url: 'about:blank' });
  const { sessionId } = await send('Target.attachToTarget', { targetId, flatten: true });
  const S = (m, p) => send(m, p, sessionId);
  const ev = async expr => {
    const r = await withTimeout(S('Runtime.evaluate', { expression: expr, returnByValue: true, awaitPromise: true }), 25000, 'eval');
    if (r && r.exceptionDetails) throw new Error('JS: ' + JSON.stringify(r.exceptionDetails).slice(0, 300));
    return r.result.value;
  };
  await S('Page.enable'); await S('Runtime.enable');
  await S('Emulation.setDeviceMetricsOverride', { width: 1080, height: 700, deviceScaleFactor: DPR, mobile: true });

  const SEL = `'#questionWrap .ekz-ink-cv'`;

  /* 真实像素统计：总数 + 擦除带内残留 + 纵向范围（CSS px） */
  const STAT = (y0f, y1f) => `(function(){
    var cv=document.querySelector(${SEL});
    if(!cv) return JSON.stringify({err:'no-cv'});
    var w=cv.width,h=cv.height;
    var d=cv.getContext('2d').getImageData(0,0,w,h).data;
    var dpr=${DPR};
    var cssH=cv.getBoundingClientRect().height;
    var bandTop=Math.floor(h*${y0f}), bandBot=Math.floor(h*${y1f});
    var total=0, band=0, top=-1, bot=-1;
    for(var y=0;y<h;y++){
      var rowHit=false;
      for(var x=0;x<w;x++){
        if(d[(y*w+x)*4+3]>8){
          total++; rowHit=true;
          if(y>=bandTop&&y<bandBot) band++;
        }
      }
      if(rowHit){ if(top<0) top=y; bot=y; }
    }
    return JSON.stringify({
      total:total, band:band,
      bufH:h, cssH:Math.round(cssH),
      squash: Math.round((h/dpr)/cssH*1000)/1000,
      inkTopCSS: top<0?-1:Math.round(top/dpr), inkBotCSS: bot<0?-1:Math.round(bot/dpr),
      strokes: (function(){try{return JSON.parse(localStorage.getItem('ekz-ink-bk-2017-text3-mark-question')||'[]').length}catch(e){return -1}})()
    });
  })()`;

  /* 画一条横线（在 100% 可见区内），再横穿擦掉中段 */
  const SCENE = `(async function(){
    var cv=document.querySelector(${SEL});
    if(!cv) return 'no-cv';
    var host=cv.parentElement; host.scrollIntoView({block:'center'});
    await new Promise(function(r){setTimeout(r,450);});
    var r=cv.getBoundingClientRect();
    var vTop=Math.max(r.top,0), vBot=Math.min(r.top+r.height, innerHeight);
    var span=Math.max(vBot-vTop,1);
    var y=vTop+span*0.4;
    function pe(t,xx,yy){ return new PointerEvent(t,{pointerId:51,pointerType:'pen',isPrimary:true,
      bubbles:true,cancelable:true,clientX:xx,clientY:yy,pressure:0.5,buttons:t==='pointerup'?0:1}); }
    /* 画横线 15%→85% */
    var x0=r.left+r.width*0.15, x1=r.left+r.width*0.85;
    cv.dispatchEvent(pe('pointerdown',x0,y));
    await new Promise(function(res){ var i=0; var step=function(){
      i++; if(i>26){ cv.dispatchEvent(pe('pointerup',x1,y)); return setTimeout(res,400); }
      cv.dispatchEvent(pe('pointermove', x0+(x1-x0)*i/26, y)); setTimeout(function(){step();},12); }; step(); });
    /* 长按 650ms 触发橡皮，横穿 35%→65% */
    var ex0=r.left+r.width*0.35, ex1=r.left+r.width*0.65;
    cv.dispatchEvent(pe('pointerdown',ex0,y));
    await new Promise(function(res){ setTimeout(res,650); });
    await new Promise(function(res){ var i=0; var step=function(){
      i++; if(i>18){ cv.dispatchEvent(pe('pointerup',ex1,y)); return setTimeout(res,450); }
      cv.dispatchEvent(pe('pointermove', ex0+(ex1-ex0)*i/18, y)); setTimeout(function(){step();},14); }; step(); });
    return 'scene-done';
  })()`;

  async function freshRun(label, doZoom) {
    console.log('\n=== ' + label + ' ===');
    await withTimeout(S('Page.navigate', { url: T3 }), 20000, 'nav');
    await sleep(4500);
    await ev(`(async function(){ try{ await ekzDB.destroy(); }catch(e){}
      try{ Object.keys(localStorage).forEach(function(k){ if(k.indexOf('ekz-ink-bk-')===0) localStorage.removeItem(k); }); }catch(e){}
      return 1; })()`);
    await withTimeout(S('Page.navigate', { url: T3 }), 20000, 'nav2');
    await sleep(6000);
    if (doZoom) {
      await ev(`(function(){ document.getElementById('questionWrap').style.width='min(calc(100% * 1.9), calc(820px * 1.9))'; return 1;})()`);
      await sleep(2200);
      await ev(`(function(){ document.getElementById('questionWrap').style.width=''; return 1;})()`);
      await sleep(2200);
      const gz = JSON.parse(await ev(STAT(0, 1)));
      console.log('  缩放往返后: backing/css = ' + gz.squash + '（1=正常，>1=被压扁）');
    }
    console.log('  ' + await ev(SCENE));
    await sleep(1500);
    /* 擦除带取整条线所在的那一带：线在 0.4 附近，线宽有限，取 0.30~0.50 */
    const s = JSON.parse(await ev(STAT(0.30, 0.50)));
    console.log('  ' + JSON.stringify(s));
    return s;
  }

  const A = await freshRun('A 组：全新状态（从未缩放）', false);
  const B = await freshRun('B 组：捏合放大 1.9x 后复位 100%', true);

  console.log('\n=== A/B 对照 ===');
  console.log('  A 残留像素(擦除带内) = ' + A.band + ' / 总 ' + A.total + '，压扁比 ' + A.squash);
  console.log('  B 残留像素(擦除带内) = ' + B.band + ' / 总 ' + B.total + '，压扁比 ' + B.squash);
  ok(A.band < 200, 'A 组擦干净（残留 ' + A.band + ' 像素）');
  ok(B.squash > 1.3, 'B 组画布被纵向压扁（backing/css = ' + B.squash + '）—— 这就是 basisH 不回落');
  ok(B.band > A.band * 2,
    'B 组残留明显更多（' + A.band + ' → ' + B.band + '）—— 压扁态下橡皮擦不干净');

  if (evts.length) { console.log('\n  异常:'); [...new Set(evts)].slice(0, 6).forEach(e => console.log('    ! ' + e)); }
  console.log('\n通过 ' + pass + ' / 失败 ' + fail);
  try { proc.kill(); } catch (_) {}
  process.exit(fail ? 1 : 0);
})().catch(e => { console.log('失败: ' + e.message); process.exit(1); });
